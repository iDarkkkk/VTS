USE Paradise_NIVS_Cloud
GO
if object_id('[dbo].[fn_GetLeaderGroups]') is null
	EXEC('CREATE FUNCTION [dbo].[fn_GetLeaderGroups]()RETURNS @TableName TABLE (Col1 int) AS BEGIN RETURN END')
GO

ALTER FUNCTION [dbo].[fn_GetLeaderGroups]
(
    @LoginID VARCHAR(50)
)
RETURNS @Result TABLE (
    GroupTeamID INT,
    GroupTeamName NVARCHAR(255)
)
AS
BEGIN
    Declare @IsAdmin bit = 0;
    declare @EmpID varchar(50), @IsProduction4Leader bit = 0;

    select @EmpID = EmployeeID from tblSC_Login where LoginID = @LoginID;

    if exists (
        select 1
        from dbo.fn_vtblEmployeeList_Simple_ByDate(getdate(), '-1', null) e
        inner join tblPosition p on e.PositionID = p.PositionID
        where e.EmployeeID = @EmpID and p.PositionName like '%Leader%' and e.DivisionID in (11, 17)

        union

        select 1
        from tblReponLeader rl
        inner join dbo.fn_vtblEmployeeList_Simple_ByDate(getdate(), '-1', null) e on rl.EmployeeID = e.EmployeeID
        where rl.EmployeeID = @EmpID and e.DivisionID in (11, 17)

        union

        select 1
        from tblDivision d
        cross apply string_split(cast(d.ClerkEmployeeID as varchar(500)), '&')
        inner join dbo.fn_vtblEmployeeList_Simple_ByDate(getdate(), '-1', null) e on e.EmployeeID = @EmpID
        where d.DivisionID in (11, 17) and ltrim(rtrim(value)) = @EmpID and e.DivisionID in (11, 17)
    )
    begin
        set @IsProduction4Leader = 1;
    end
    --Lấy quyền ra
    if exists ( select 1 from tblSC_Login cross apply string_split(cast(ParentLoginID as varchar(500)), '&')
        where LoginID = @LoginID and TRY_CAST(LTRIM(RTRIM(value)) AS INT) in (91,1097))
    begin
        set @IsAdmin = 1;
    end

    if @IsAdmin = 1 and @IsProduction4Leader = 0
    begin
        insert into @Result (GroupTeamID, GroupTeamName)
        select GroupTeamID, GroupTeamName
        from tblGroupTeam
        where GroupTeamName IS NOT NULL;
    end
    else
    begin
        if @IsProduction4Leader = 1
        begin
            insert into @Result (GroupTeamID, GroupTeamName)
            select distinct leader.SectionID, isnull(leader.SectionName, 'N/A') as GroupTeamName
            from (
                select e.EmployeeID, e.SectionID, e.SectionName
                from dbo.fn_vtblEmployeeList_Simple_ByDate(getdate(), '-1', null) e
                inner join tblPosition p on e.PositionID = p.PositionID
                where e.EmployeeID = @EmpID and p.PositionName like '%Leader%' and e.DivisionID in (11, 17)

                union

                select e.EmployeeID, e.SectionID, e.SectionName
                from tblReponLeader rl
                inner join dbo.fn_vtblEmployeeList_Simple_ByDate(getdate(), '-1', null) e on rl.EmployeeID = e.EmployeeID
                where rl.EmployeeID = @EmpID and e.DivisionID in (11, 17)

                union

                select e.EmployeeID, e.SectionID, e.SectionName
                from tblDivision d
                cross apply string_split(cast(d.ClerkEmployeeID as varchar(500)), '&')
                inner join dbo.fn_vtblEmployeeList_Simple_ByDate(getdate(), '-1', null) e on e.EmployeeID = @EmpID
                where d.DivisionID in (11, 17) and ltrim(rtrim(value)) = @EmpID and e.DivisionID in (11, 17)
            ) leader
            where leader.SectionID is not null;
        end
        else
        begin
            insert into @Result (GroupTeamID, GroupTeamName)
            select c.GroupTeamID, ISNULL(g.GroupTeamName, 'N/A') AS GroupTeamName
            from (
                select e.GroupTeamID
                from tblSC_Login l
                inner join dbo.fn_vtblEmployeeList_Simple_ByDate(GETDATE(), '-1', null) e on l.EmployeeID = e.EmployeeID
                inner join tblPosition p  on e.PositionID = p.PositionID
                where LoginID = @LoginID and p.PositionName like '%Leader%' and e.GroupTeamID is not null

                union
                --Kiem nhiem ne
                select try_cast(ltrim(rtrim(value)) as int) as GroupTeamID
                from tblSC_Login l
                cross apply string_split(cast(l.assignfor as varchar(500)), '&')
                WHERE LoginID = @LoginID AND TRY_CAST(LTRIM(RTRIM(value)) as int) is not null
            ) c inner join tblGroupTeam g on c.GroupTeamID = g.GroupTeamID;
        end
    END

    RETURN;
END
GO
